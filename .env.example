# Copy this file to `.env.local` (Git-ignored) and fill with YOUR values.
# Get them from Supabase Dashboard → Project Settings → API

# 1. Public Supabase project URL.
#    ⚠️ MUST be the PROJECT ROOT, ending with `.supabase.co`.
#    ❌ DO NOT include `/rest/v1` or `/auth/v1` or any trailing path.
#    Example: https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# 2. Public anon key (safe for the browser — RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 3. Service role key — ⚠️ SECRET — NEVER commit to Git, never expose to client.
#    Bypasses Row Level Security. Only used by server API routes on the backend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 4. Private storage bucket for payment screenshots.
#    Create via Supabase Dashboard → Storage → New bucket (PRIVATE, OFF).
#    Default name is payment-proofs.
SUPABASE_PAYMENT_BUCKET=payment-proofs
